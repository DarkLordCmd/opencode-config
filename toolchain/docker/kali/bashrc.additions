# shell additions for the pt/kali image
export PINTEST_HOME=/pintest
export GOPATH=/root/go
export PATH=/root/.local/bin:/root/go/bin:$PATH
cd /pintest 2>/dev/null || true

# quick reminders
alias pth='echo "engagement root: /pintest  (E:\\pintest on the host)"'
alias lh='ip -4 addr show scope global | grep -oP "(?<=inet\\s)\\d+(\\.\\d+){3}" | head -1'
PS1='\[\e[1;31m\][pt]\[\e[0m\] \w \$ '

# reverse-shell listener helper: lsn <port>
lsn() { local p="${1:-4444}"; echo "[*] listening on 0.0.0.0:$p  (LHOST = Windows host IP, published 4444-4450)"; nc -lvnp "$p"; }
